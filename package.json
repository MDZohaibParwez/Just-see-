{
  "name": "just-see",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @just-see/web dev",
    "build": "pnpm --filter @just-see/web build",
    "start": "pnpm --filter @just-see/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter ./packages/** test",
    "test:e2e": "pnpm --filter @just-see/web test:e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
